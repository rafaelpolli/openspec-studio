{
  "name": "openspec-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e/tsconfig.json",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter '@studio/server' --filter '@studio/web' dev",
    "e2e": "bun test --timeout 60000 ./e2e",
    "build": "bun run --filter '@studio/web' build",
    "start": "bun run build && bun packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.8.0"
  }
}
